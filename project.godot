; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The World's Easiest Game"
config/description="Just wait 30 seconds to win the game. Don't do anything else."
config/version="0.1.0"
config/tags=PackedStringArray("2d")
run/main_scene="uid://bfwrvxdibkpgu"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://cglb1yrg1i7yv"

[audio]

buses/default_bus_layout="uid://dvkc5thm1bwc5"

[autoload]

Screenshots="*uid://bljdk7ctqona7"
GlobalResources="*uid://by1hfnayr4eyw"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"strix": "res://characters/strix.dch"
}
directories/dtl_directory={
"intro": "res://timelines/intro.dtl"
}
layout/style_directory={}
layout/style_list=[]
layout/default_style="Default"
variables={
"know_strix_name": false,
"strix": {
"name": "Strix",
"regular_name": "Strix",
"unknown_name": "???"
}
}
text/letter_speed=0.02
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
text/autocolor_names=true

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/movie_file="C:/Users/dvy/Documents/The World's Easiest Game/movie.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/gdfxr/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/screenshots/plugin.cfg")

